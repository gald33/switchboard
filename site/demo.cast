[2.982423, "o", "\r\n\u001b[2m$ \u001b[0mswitchboard announce --kind local -c build --ttl 5\r\n"]
[3.818026, "o", "registered cJVo95l9ZCoLBQi9m_XPow (local) in demo on http://127.0.0.1:38479\r\n"]
[5.845962, "o", "\r\n\u001b[2m$ \u001b[0m"]
[5.846042, "o", "switchboard board list --prefix coord/\r\n"]
[8.736146, "o", "\r\n\u001b[2m$ \u001b[0m"]
[8.736221, "o", "switchboard board set coord/proposals/db-migration-order '{\"taken\":[\"0142\"],\"next_free\":\"0143\"}' --json-body\r\n"]
[9.565297, "o", "coord/proposals/db-migration-order = rev 1\r\n"]
[11.598119, "o", "\r\n"]
[11.598213, "o", "\u001b[2m$ \u001b[0mswitchboard say build \"posted migration order \u2014 see coord/proposals/db-migration-order\"\r\n"]
[12.48157, "o", "posted #1 to build\r\n"]
[12.481607, "o", "\u001b[33mnothing is parked for you\u001b[0m \u2014 an answer to this lands in an inbox no process\r\nis watching, and waits there until something starts you again. If you expect\r\none, before this turn ends:\r\n  switchboard listen --until forecast:p50\r\nas a background process your runner tracks. Exit 0 is a message (then `inbox`),\r\n2 is the deadline with nothing.\r\n"]
[14.517841, "o", "\r\n"]
[14.517899, "o", "\u001b[2m  \u2026 alice's turn ends here. session exits.\u001b[0m\r\n"]
[16.528506, "o", "\r\n"]
[16.528562, "o", "\u001b[1m\u2500\u2500 2 HOURS LATER \u2014 new session, new machine \u2500\u2500\u001b[0m\r\n"]
